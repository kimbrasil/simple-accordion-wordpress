msgid "A lightweight, accessible accordion manager that supports multiple accordions and renders them with the [simple_accordion] shortcode."
msgstr "একটি হালকা ও সহজলভ্য অ্যাকর্ডিয়ন ম্যানেজার, যা একাধিক অ্যাকর্ডিয়ন সমর্থন করে এবং [simple_accordion] শর্টকোডের মাধ্যমে প্রদর্শন করে।"

msgid "Accordion"
msgstr "অ্যাকর্ডিয়ন"

msgid "Accordion saved."
msgstr "অ্যাকর্ডিয়ন সংরক্ষিত হয়েছে।"

msgid "Accordion title"
msgstr "অ্যাকর্ডিয়নের শিরোনাম"

msgid "Action"
msgstr "অ্যাকশন"

msgid "Add item"
msgstr "আইটেম যোগ করুন"

msgid "Content"
msgstr "বিষয়বস্তু"

msgid "Create new"
msgstr "নতুন তৈরি করুন"

msgid "Create separate accordions and place each one with its own shortcode."
msgstr "আলাদা অ্যাকর্ডিয়ন তৈরি করুন এবং প্রতিটিকে নিজস্ব শর্টকোড দিয়ে স্থাপন করুন।"

msgid "Initially open"
msgstr "প্রাথমিকভাবে খোলা"

msgid "kimbrasil"
msgstr "kimbrasil"

msgid "Open"
msgstr "খোলা"

msgid "Order"
msgstr "ক্রম"

msgid "Remove"
msgstr "সরান"

msgid "Save accordion"
msgstr "অ্যাকর্ডিয়ন সংরক্ষণ করুন"

msgid "Shortcode ID"
msgstr "শর্টকোড আইডি"

msgid "Shortcode:"
msgstr "শর্টকোড:"

msgid "Simple Accordion"
msgstr "সাধারণ অ্যাকর্ডিয়ন"

msgid "Simple Accordions"
msgstr "সহজ অ্যাকর্ডিয়ন"

msgid "Title"
msgstr "শিরোনাম"

msgid "Use this ID in [simple_accordion id=\"your-id\"]."
msgstr "[simple_accordion id=\"your-id\"]-এ এই আইডি ব্যবহার করুন।"

msgid "You do not have permission to access this page."
msgstr "এই পৃষ্ঠায় প্রবেশ করার অনুমতি আপনার নেই।"
